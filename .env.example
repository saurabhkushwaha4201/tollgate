# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/tollgate

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-here-minimum-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
REFRESH_SECRET=your_refresh_secret

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # get this from: stripe listen --forward-to localhost:3000/billing/webhook
STRIPE_PRO_PRICE_ID=price_...     # create in Stripe dashboard → Products
STRIPE_ENTERPRISE_PRICE_ID=price_...

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000   # used for Stripe redirect URLs
LOG_LEVEL=info                       # pino log level: trace|debug|info|warn|error
